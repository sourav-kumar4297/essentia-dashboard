# Neon Postgres (required) — must start with postgresql://
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Superadmin emails (comma-separated) — HubSpot + team roles / block users
SUPERADMIN_EMAILS="souravkumar4297@gmail.com"
# Extra BD Admin emails (comma-separated). Built-in: admin@essentia.com
ADMIN_EMAILS=""

# HMAC secret for login JWTs (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

RESEND_API_KEY="re_xxxxxxxxx"
# Must use your verified Resend domain — onboarding@resend.dev can only mail your own inbox
RESEND_FROM="Essentia <noreply@essentia.in>"

# If Resend cannot deliver (sandbox / unverified domain), show the OTP on screen
ALLOW_DEV_OTP="true"

# Direct no-OTP test logins: admin@essentia.com (ADMIN), member@essentia.com (MEMBER).
# Set to "false" on Vercel to hide test buttons and disable /api/auth/login shortcuts.
# No spaces around = — use ALLOW_TEST_LOGIN="true"
ALLOW_TEST_LOGIN="true"

# HubSpot Service Key
HUBSPOT_ACCESS_TOKEN=

# Vercel Cron (Settings → Environment Variables). Vercel sends this as Bearer.
CRON_SECRET=
