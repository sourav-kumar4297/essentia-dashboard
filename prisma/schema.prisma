generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  /// SUPERADMIN | ADMIN | MEMBER
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  assignedLeads Lead[]         @relation("AssignedLeads")
  createdLeads  Lead[]         @relation("CreatedLeads")
  activities    LeadActivity[]
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, code])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id                 String   @id @default(cuid())
  name               String
  phone              String
  email              String   @default("")
  source             String
  /// NEW | CONTACTED | IN_DISCUSSION | PROPOSAL_SENT | WON | LOST | HOLD
  status             String   @default("NEW")
  /// NONE | PENDING | APPROVED | REJECTED
  referralApproval   String   @default("NONE")
  isPersonalReferral Boolean  @default(false)
  qualification      String   @default("Unqualified")
  location           String   @default("")
  territory          String   @default("Gurugram")
  businessUnit       String   @default("EE")
  projectType        String   @default("residential")
  budgetIndication   String?
  dealValue          Float?
  notes              String?
  hubspotId          String?  @unique
  assignedToId       String?
  createdById        String?
  pioReleased          Boolean @default(false)
  firstPaymentReceived Boolean @default(false)
  docsComplete         Boolean @default(false)
  handoverComplete     Boolean @default(false)
  handoverNotes        String?
  crmTeamLead          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastFollowUpAt     DateTime?
  firstContactedAt   DateTime?

  assignedTo User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy  User?          @relation("CreatedLeads", fields: [createdById], references: [id])
  activities LeadActivity[]

  @@index([status])
  @@index([assignedToId])
  @@index([referralApproval])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  createdById String?
  /// CALL | EMAIL | WHATSAPP | MEETING | NOTE | STATUS
  type        String
  body        String
  createdAt   DateTime @default(now())

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([leadId])
}
